# Written by `npx convex dev` for local development.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Long random string. Must ALSO be set on the Convex deployment:
#   npx convex env set CONVEX_SERVER_SECRET <value>
CONVEX_SERVER_SECRET=

# Optional. How ambiguous dates like 03/04/2025 are read: AUTO (default) reads
# day-first on Spanish receipts and month-first otherwise; DMY/MDY force one.
# NEXT_PUBLIC_DATE_ORDER=AUTO
